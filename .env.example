# PayPal Sandbox API Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Environment (must be "sandbox")
PAYPAL_ENV=sandbox

# Maximum allowed transaction amount in USD (positive number, default: 100)
MAX_AMOUNT=100

# Application Port (optional, default: 3000)
PORT=3000

# MongoDB Connection URI (required)
MONGODB_URI=mongodb://localhost:27017/paypilot_checkout

# PayPal Webhook ID (Optional for local dev, created in PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# Optional Google Gemini API Key for AI Assistant intent parsing
GEMINI_API_KEY=your_gemini_api_key_here

