# PayPal Sandbox API Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Environment (must be "sandbox")
PAYPAL_ENV=sandbox

# Maximum allowed transaction amount in USD (positive number, default: 100)
MAX_AMOUNT=100

# Application Port (optional, default: 3000)
PORT=3000
